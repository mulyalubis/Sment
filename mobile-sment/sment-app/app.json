{
  "expo": {
    "name": "sment-app",
    "slug": "sment-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "smentapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.yavsc.smentapp"
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "sment-app memerlukan kamera untuk memotret sampah."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "sment-app memerlukan lokasi untuk menandai tempat sampah."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "25ca03dc-9cda-4f11-b16c-a392d8f2de28"
      }
    }
  }
}
